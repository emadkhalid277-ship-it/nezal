rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'emadkhalid277@gmail.com' ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    function isValidMainCategoryName(mainCat) {
      return mainCat is string &&
        mainCat.size() >= 2 &&
        mainCat.size() <= 80 &&
        mainCat != 'مسلسلات وأفلام';
    }

    function isValidSubcategoryName(cat) {
      return cat is string &&
        cat.size() >= 2 &&
        cat.size() <= 80;
    }

    function isValidMainCategoryConfig(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'description',
          'imageUrl',
          'sortOrder',
          'isActive',
          'updatedBy',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'description',
          'tagline',
          'imageUrl',
          'sortOrder',
          'isActive',
          'isComingSoon',
          'isDeleted',
          'accentColor',
          'bgTint',
          'borderTint',
          'iconName',
          'updatedBy',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidMainCategoryName(data.name) &&
        data.description is string && data.description.size() <= 300 &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200)) &&
        data.imageUrl is string && data.imageUrl.size() <= 500000 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.isActive is bool &&
        (!('isComingSoon' in data) || data.isComingSoon is bool) &&
        (!('isDeleted' in data) || data.isDeleted is bool) &&
        (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() >= 4 && data.accentColor.size() <= 20)) &&
        (!('bgTint' in data) || (data.bgTint is string && data.bgTint.size() >= 4 && data.bgTint.size() <= 20)) &&
        (!('borderTint' in data) || (data.borderTint is string && data.borderTint.size() >= 4 && data.borderTint.size() <= 20)) &&
        (!('iconName' in data) || (data.iconName is string && data.iconName.size() >= 2 && data.iconName.size() <= 30)) &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidSubcategory(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'mainCategory',
          'description',
          'sortOrder',
          'isActive',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'mainCategoryId',
          'mainCategory',
          'description',
          'sortOrder',
          'isActive',
          'isComingSoon',
          'isDeleted',
          'imageUrl',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidSubcategoryName(data.name) &&
        (!('mainCategoryId' in data) || isValidId(data.mainCategoryId)) &&
        isValidMainCategoryName(data.mainCategory) &&
        data.description is string && data.description.size() <= 240 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.isActive is bool &&
        (!('isComingSoon' in data) || data.isComingSoon is bool) &&
        (!('isDeleted' in data) || data.isDeleted is bool) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000)) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidContactSettings(data) {
      return data.keys().hasAll([
          'id',
          'heading',
          'message',
          'whatsappUrl',
          'whatsappDisplay',
          'emailAddress',
          'twitterUrl',
          'instagramUrl',
          'tiktokUrl',
          'snapchatUrl',
          'updatedBy',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'heading',
          'message',
          'whatsappUrl',
          'whatsappDisplay',
          'emailAddress',
          'twitterUrl',
          'instagramUrl',
          'tiktokUrl',
          'snapchatUrl',
          'updatedBy',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.heading is string && data.heading.size() >= 2 && data.heading.size() <= 120 &&
        data.message is string && data.message.size() <= 500 &&
        data.whatsappUrl is string && data.whatsappUrl.size() <= 300 &&
        data.whatsappDisplay is string && data.whatsappDisplay.size() <= 120 &&
        data.emailAddress is string && data.emailAddress.size() <= 200 &&
        data.twitterUrl is string && data.twitterUrl.size() <= 300 &&
        data.instagramUrl is string && data.instagramUrl.size() <= 300 &&
        data.tiktokUrl is string && data.tiktokUrl.size() <= 300 &&
        data.snapchatUrl is string && data.snapchatUrl.size() <= 300 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidPointStealSettings(data) {
      return data.keys().hasAll([
          'id',
          'enabled',
          'stealTimerSeconds',
          'modeScope',
          'updatedBy',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'enabled',
          'stealTimerSeconds',
          'modeScope',
          'updatedBy',
          'updatedAt'
        ]) &&
        data.id == 'point_steal' &&
        data.enabled is bool &&
        data.stealTimerSeconds is int &&
        data.stealTimerSeconds >= 5 &&
        data.stealTimerSeconds <= 90 &&
        data.modeScope is string &&
        data.modeScope in ['all', 'local_only', 'online_only'] &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidQuestionDedupSettings(data) {
      return data.keys().hasAll([
          'id',
          'allowRepeatAfterExhaustion',
          'trackSpectators',
          'updatedBy',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'allowRepeatAfterExhaustion',
          'trackSpectators',
          'updatedBy',
          'updatedAt'
        ]) &&
        data.id == 'question_dedup' &&
        data.allowRepeatAfterExhaustion is bool &&
        data.trackSpectators is bool &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidDifficulty(diff) {
      return diff is string &&
        diff.size() >= 2 &&
        diff.size() <= 20 &&
        diff in ['سهل', 'متوسط', 'صعب', 'صعب جداً', 'خبير'];
    }

    function isValidOptionsList(opts, qType) {
      return opts is list &&
        qType == 'direct' &&
        opts.size() == 0;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll([
          'id',
          'category',
          'questionText',
          'questionType',
          'difficulty',
          'points',
          'options',
          'correctAnswer',
          'explanation',
          'source',
          'status',
          'authorId',
          'createdAt',
          'reviewedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'subcategoryId',
          'category',
          'mainCategoryId',
          'mainCategory',
          'questionText',
          'questionType',
          'difficulty',
          'points',
          'options',
          'correctAnswer',
          'explanation',
          'source',
          'status',
          'mediaType',
          'imageUrl',
          'imageStoragePath',
          'imageDescription',
          'audioUrl',
          'audioStoragePath',
          'audioMaxPlays',
          'authorId',
          'createdAt',
          'reviewedAt'
        ]) &&
        isValidId(data.id) &&
        (!('subcategoryId' in data) || isValidId(data.subcategoryId)) &&
        (!('mainCategoryId' in data) || isValidId(data.mainCategoryId)) &&
        (!('mainCategory' in data) || isValidMainCategoryName(data.mainCategory)) &&
        isValidSubcategoryName(data.category) &&
        data.questionText is string && data.questionText.size() >= 3 && data.questionText.size() <= 600 &&
        data.questionType is string && data.questionType.size() == 6 &&
        data.questionType == 'direct' &&
        isValidDifficulty(data.difficulty) &&
        data.points is int && data.points in [100, 200, 300, 400, 500] &&
        isValidOptionsList(data.options, data.questionType) &&
        data.correctAnswer is string && data.correctAnswer.size() >= 1 && data.correctAnswer.size() <= 300 &&
        data.explanation is string && data.explanation.size() <= 800 &&
        data.source is string && data.source.size() <= 300 &&
        data.status is string && data.status.size() >= 6 && data.status.size() <= 12 &&
        data.status in ['approved', 'pending', 'rejected'] &&
        (!('mediaType' in data) || (
          data.mediaType is string &&
          data.mediaType in ['text', 'image', 'audio']
        )) &&
        (!('imageUrl' in data) || (
          data.imageUrl is string &&
          data.imageUrl.size() <= 2000 &&
          (data.imageUrl.size() == 0 || data.imageUrl.matches('^https?://.*'))
        )) &&
        (!('imageStoragePath' in data) || (
          data.imageStoragePath is string &&
          data.imageStoragePath.size() <= 500
        )) &&
        (!('imageDescription' in data) || (
          data.imageDescription is string &&
          data.imageDescription.size() <= 300
        )) &&
        (!('audioUrl' in data) || (
          data.audioUrl is string &&
          data.audioUrl.size() <= 2000 &&
          (data.audioUrl.size() == 0 || data.audioUrl.matches('^https?://.*'))
        )) &&
        (!('audioStoragePath' in data) || (
          data.audioStoragePath is string &&
          data.audioStoragePath.size() <= 500
        )) &&
        (!('audioMaxPlays' in data) || (
          data.audioMaxPlays == null ||
          (data.audioMaxPlays is int && data.audioMaxPlays >= 1 && data.audioMaxPlays <= 20)
        )) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (data.reviewedAt is timestamp || (data.reviewedAt is string && data.reviewedAt.size() <= 64));
    }

    // Admins collection (Read-only for self verification, cannot be self-assigned from client)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Users collection (Player profiles, roles, and authentication records)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // GameSessions collection (Saving played matches, live game progress, and scores)
    match /gameSessions/{sessionId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // MainCategories collection (Publicly readable, Admin-only write for full main category management)
    match /mainCategories/{mainCategoryId} {
      allow get: if isValidId(mainCategoryId);
      allow list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(mainCategoryId) &&
        isValidMainCategoryConfig(incoming()) &&
        incoming().id == mainCategoryId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(mainCategoryId) &&
        isValidMainCategoryConfig(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'description',
          'tagline',
          'imageUrl',
          'sortOrder',
          'isActive',
          'isComingSoon',
          'isDeleted',
          'accentColor',
          'bgTint',
          'borderTint',
          'iconName',
          'updatedBy',
          'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(mainCategoryId) && isAdmin();
    }

    // Subcategories collection (Publicly readable, Admin-only write)
    match /subcategories/{subcategoryId} {
      allow get: if isValidId(subcategoryId);
      allow list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(subcategoryId) &&
        isValidSubcategory(incoming()) &&
        incoming().id == subcategoryId &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(subcategoryId) &&
        isValidSubcategory(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'mainCategoryId',
          'mainCategory',
          'description',
          'sortOrder',
          'isActive',
          'isComingSoon',
          'isDeleted',
          'imageUrl',
          'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(subcategoryId) && isAdmin();
    }

    // Platform Settings collection (e.g., /settings/contact, /settings/point_steal, /settings/question_dedup)
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(settingId) &&
        (
          (settingId == 'point_steal' && isValidPointStealSettings(incoming())) ||
          (settingId == 'question_dedup' && isValidQuestionDedupSettings(incoming())) ||
          (settingId != 'point_steal' && settingId != 'question_dedup' && isValidContactSettings(incoming()))
        ) &&
        incoming().id == settingId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(settingId) &&
        (
          (settingId == 'point_steal' && isValidPointStealSettings(incoming())) ||
          (settingId == 'question_dedup' && isValidQuestionDedupSettings(incoming())) ||
          (settingId != 'point_steal' && settingId != 'question_dedup' && isValidContactSettings(incoming()))
        ) &&
        incoming().id == existing().id &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow delete: if false;
    }

    // Questions collection
    match /questions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if true;

      allow create: if isValidId(questionId) && (
        isAdmin() ||
        (incoming().authorId == 'system' && incoming().status == 'pending' && isValidQuestion(incoming()))
      );

      allow update: if isValidId(questionId) && isAdmin();

      allow delete: if isValidId(questionId) && isAdmin();
    }

    // User Question Lists (Personal question lists belonging strictly to the user)
    match /userQuestionLists/{listId} {
      allow get: if isSignedIn() && isValidId(listId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(listId) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(listId) && (existing().userId == request.auth.uid || isAdmin()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(listId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // User Custom Questions (Private questions inside personal lists)
    match /userCustomQuestions/{questionId} {
      allow get: if isSignedIn() && isValidId(questionId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(questionId) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(questionId) && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(questionId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Contributions collection (Questions submitted by users for admin review)
    match /contributions/{contributionId} {
      allow get: if isSignedIn() && isValidId(contributionId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(contributionId) && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Online Multiplayer Game Rooms (Realtime synchronization & game state)
    match /gameRooms/{roomId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // User Game Matches collection (Personal match progress and match history)
    match /userGameMatches/{matchId} {
      allow get: if isValidId(matchId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(matchId) && incoming().userId == request.auth.uid;
      allow update: if isValidId(matchId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow delete: if isValidId(matchId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    // =========================================================================
    // SOCIAL SYSTEM (Friends, Presence, Blocking, Invites, Notifications)
    // =========================================================================

    function isNumberVal(val) {
      return val is int || val is float;
    }

    function isNotBlockedBetween(uidA, uidB) {
      return !exists(/databases/$(database)/documents/userBlocks/$(uidA + '_' + uidB)) &&
        !exists(/databases/$(database)/documents/userBlocks/$(uidB + '_' + uidA));
    }

    function isValidPlayerProfile(data, targetUid) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'displayNameLower',
          'acceptsInvites',
          'presenceStatus',
          'isExplicitlyOnline',
          'lastHeartbeat'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'displayNameLower',
          'photoURL',
          'acceptsInvites',
          'presenceStatus',
          'isExplicitlyOnline',
          'currentRoomCode',
          'sessionId',
          'lastHeartbeat',
          'updatedAt'
        ]) &&
        data.uid == targetUid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.displayNameLower is string && data.displayNameLower.size() >= 1 && data.displayNameLower.size() <= 100 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        data.acceptsInvites is bool &&
        data.presenceStatus in ['online', 'offline', 'in_lobby', 'in_match'] &&
        data.isExplicitlyOnline is bool &&
        (!('currentRoomCode' in data) || data.currentRoomCode == null || (data.currentRoomCode is string && data.currentRoomCode.size() <= 16)) &&
        (!('sessionId' in data) || data.sessionId == null || (data.sessionId is string && data.sessionId.size() <= 128)) &&
        isNumberVal(data.lastHeartbeat) &&
        (!('updatedAt' in data) || isNumberVal(data.updatedAt) || data.updatedAt is timestamp);
    }

    // Public non-PII Player Profiles & Realtime Presence
    match /playerProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidPlayerProfile(incoming(), userId);
      allow delete: if isAdmin();
    }

    // User Blocks (blockerUid_blockedUid)
    match /userBlocks/{blockId} {
      allow get: if isSignedIn() && isValidId(blockId) && (
        blockId.matches('^' + request.auth.uid + '_.*') ||
        blockId.matches('.*_' + request.auth.uid + '$')
      );
      allow list: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(blockId) &&
        incoming().keys().hasAll(['id', 'blockerUid', 'blockedUid', 'createdAt']) &&
        incoming().keys().hasOnly(['id', 'blockerUid', 'blockedUid', 'blockedName', 'blockedPhotoURL', 'createdAt']) &&
        incoming().id == blockId &&
        incoming().blockerUid == request.auth.uid &&
        isValidId(incoming().blockedUid) &&
        incoming().blockedUid != request.auth.uid &&
        blockId == request.auth.uid + '_' + incoming().blockedUid &&
        isNumberVal(incoming().createdAt);
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(blockId) && existing().blockerUid == request.auth.uid;
    }

    // Friend Requests (fromUid_toUid)
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        incoming().keys().hasAll(['id', 'fromUid', 'toUid', 'status', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['id', 'fromUid', 'fromName', 'fromPhotoURL', 'toUid', 'toName', 'toPhotoURL', 'status', 'createdAt', 'updatedAt']) &&
        incoming().id == requestId &&
        incoming().fromUid == request.auth.uid &&
        isValidId(incoming().toUid) &&
        incoming().toUid != request.auth.uid &&
        requestId == incoming().fromUid + '_' + incoming().toUid &&
        incoming().status == 'pending' &&
        isNumberVal(incoming().createdAt) &&
        isNumberVal(incoming().updatedAt) &&
        isNotBlockedBetween(incoming().fromUid, incoming().toUid);

      allow update: if isSignedIn() &&
        isValidId(requestId) &&
        incoming().id == existing().id &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        isNumberVal(incoming().updatedAt) &&
        (
          // Only recipient can accept or reject a pending request
          (
            existing().toUid == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status in ['accepted', 'rejected']
          ) ||
          // Only sender can cancel a pending request
          (
            existing().fromUid == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'cancelled'
          ) ||
          // Sender may re-send after rejection, cancellation, or prior unfriend if not blocked
          (
            existing().fromUid == request.auth.uid &&
            existing().status in ['rejected', 'cancelled', 'accepted'] &&
            incoming().status == 'pending' &&
            isNotBlockedBetween(existing().fromUid, existing().toUid)
          ) ||
          // Either user may mark an accepted request as cancelled when unfriending or blocking
          (
            (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid) &&
            existing().status == 'accepted' &&
            incoming().status == 'cancelled'
          )
        );

      allow delete: if isSignedIn() && isValidId(requestId) && (
        existing().fromUid == request.auth.uid ||
        existing().toUid == request.auth.uid
      );
    }

    // Verified Mutual Friendships (sorted minUid_maxUid)
    match /friendships/{pairId} {
      allow get: if isSignedIn() && isValidId(pairId) && (
        resource.data.user1 == request.auth.uid ||
        resource.data.user2 == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.user1 == request.auth.uid ||
        resource.data.user2 == request.auth.uid
      );
      allow create: if isSignedIn() &&
        isValidId(pairId) &&
        incoming().keys().hasAll(['id', 'user1', 'user2', 'requestId', 'createdBy', 'createdAt']) &&
        incoming().keys().hasOnly(['id', 'user1', 'user2', 'user1Name', 'user1PhotoURL', 'user2Name', 'user2PhotoURL', 'requestId', 'createdBy', 'createdAt']) &&
        incoming().id == pairId &&
        isValidId(incoming().user1) &&
        isValidId(incoming().user2) &&
        incoming().user1 < incoming().user2 &&
        pairId == incoming().user1 + '_' + incoming().user2 &&
        (incoming().user1 == request.auth.uid || incoming().user2 == request.auth.uid) &&
        incoming().createdBy == request.auth.uid &&
        isNumberVal(incoming().createdAt) &&
        isValidId(incoming().requestId) &&
        exists(/databases/$(database)/documents/friendRequests/$(incoming().requestId)) &&
        get(/databases/$(database)/documents/friendRequests/$(incoming().requestId)).data.toUid == request.auth.uid &&
        get(/databases/$(database)/documents/friendRequests/$(incoming().requestId)).data.status == 'pending' &&
        (
          (
            get(/databases/$(database)/documents/friendRequests/$(incoming().requestId)).data.fromUid == incoming().user1 &&
            get(/databases/$(database)/documents/friendRequests/$(incoming().requestId)).data.toUid == incoming().user2
          ) ||
          (
            get(/databases/$(database)/documents/friendRequests/$(incoming().requestId)).data.fromUid == incoming().user2 &&
            get(/databases/$(database)/documents/friendRequests/$(incoming().requestId)).data.toUid == incoming().user1
          )
        ) &&
        getAfter(/databases/$(database)/documents/friendRequests/$(incoming().requestId)).data.status == 'accepted' &&
        isNotBlockedBetween(incoming().user1, incoming().user2);

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(pairId) && (
        existing().user1 == request.auth.uid ||
        existing().user2 == request.auth.uid
      );
    }

    // Game Invites (Play & Spectator invitations)
    match /gameInvites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        isValidId(inviteId) &&
        incoming().keys().hasAll(['id', 'fromUid', 'toUid', 'roomCode', 'inviteType', 'status', 'createdAt', 'expiresAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['id', 'fromUid', 'fromName', 'fromPhotoURL', 'toUid', 'toName', 'roomCode', 'inviteType', 'status', 'createdAt', 'expiresAt', 'updatedAt']) &&
        incoming().id == inviteId &&
        incoming().fromUid == request.auth.uid &&
        isValidId(incoming().toUid) &&
        incoming().toUid != request.auth.uid &&
        incoming().roomCode is string && incoming().roomCode.size() >= 4 && incoming().roomCode.size() <= 16 &&
        incoming().inviteType in ['play', 'spectate'] &&
        inviteId == incoming().fromUid + '_' + incoming().toUid + '_' + incoming().roomCode + '_' + incoming().inviteType &&
        incoming().status == 'pending' &&
        isNumberVal(incoming().createdAt) &&
        isNumberVal(incoming().expiresAt) &&
        isNumberVal(incoming().updatedAt) &&
        isNotBlockedBetween(incoming().fromUid, incoming().toUid) &&
        (
          !exists(/databases/$(database)/documents/playerProfiles/$(incoming().toUid)) ||
          get(/databases/$(database)/documents/playerProfiles/$(incoming().toUid)).data.acceptsInvites != false
        );

      allow update: if isSignedIn() &&
        isValidId(inviteId) &&
        incoming().id == existing().id &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().roomCode == existing().roomCode &&
        incoming().inviteType == existing().inviteType &&
        isNumberVal(incoming().updatedAt) &&
        (
          // Recipient can accept, reject, or mark expired while pending
          (
            existing().toUid == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status in ['accepted', 'rejected', 'expired']
          ) ||
          // Sender can cancel or expire while pending
          (
            existing().fromUid == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status in ['cancelled', 'expired']
          ) ||
          // Sender can re-issue a previously resolved/expired/cancelled invite
          (
            existing().fromUid == request.auth.uid &&
            existing().status in ['rejected', 'cancelled', 'expired', 'accepted'] &&
            incoming().status == 'pending' &&
            isNotBlockedBetween(existing().fromUid, existing().toUid) &&
            (
              !exists(/databases/$(database)/documents/playerProfiles/$(existing().toUid)) ||
              get(/databases/$(database)/documents/playerProfiles/$(existing().toUid)).data.acceptsInvites != false
            )
          )
        );

      allow delete: if isSignedIn() && isValidId(inviteId) && (
        existing().fromUid == request.auth.uid ||
        existing().toUid == request.auth.uid
      );
    }

    // Notifications Center
    match /notifications/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(notifId) &&
        incoming().keys().hasAll(['id', 'userId', 'actorUid', 'type', 'title', 'message', 'isRead', 'createdAt']) &&
        incoming().keys().hasOnly(['id', 'userId', 'actorUid', 'actorName', 'type', 'title', 'message', 'relatedId', 'roomCode', 'inviteType', 'isRead', 'createdAt', 'expiresAt']) &&
        incoming().id == notifId &&
        incoming().actorUid == request.auth.uid &&
        isValidId(incoming().userId) &&
        incoming().userId != request.auth.uid &&
        incoming().type in ['friend_request', 'friend_accepted', 'play_invite', 'spectate_invite', 'invite_cancelled', 'invite_expired'] &&
        incoming().isRead == false &&
        isNumberVal(incoming().createdAt) &&
        isNotBlockedBetween(incoming().actorUid, incoming().userId);
      allow update: if isSignedIn() &&
        isValidId(notifId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) &&
        incoming().isRead is bool;
      allow delete: if isSignedIn() && isValidId(notifId) && existing().userId == request.auth.uid;
    }

    // =========================================================================
    // PER-PLAYER SEEN QUESTION HISTORY (Prevent Question Repetition per UID)
    // =========================================================================

    function isValidSeenRecordId(id) {
      return id is string && id.size() >= 3 && id.size() <= 256;
    }

    function isValidUserSeenQuestion(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'questionId',
          'subcategoryId',
          'category',
          'firstSeenAtMs',
          'lastSeenAtMs',
          'seenCount',
          'mode',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'userId',
          'questionId',
          'subcategoryId',
          'category',
          'firstSeenAtMs',
          'lastSeenAtMs',
          'seenCount',
          'mode',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidSeenRecordId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.questionId) &&
        data.subcategoryId is string && data.subcategoryId.size() <= 128 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        isNumberVal(data.firstSeenAtMs) && data.firstSeenAtMs > 0 &&
        isNumberVal(data.lastSeenAtMs) && data.lastSeenAtMs >= data.firstSeenAtMs &&
        data.seenCount is int && data.seenCount >= 1 && data.seenCount <= 100000 &&
        data.mode in ['local', 'online'] &&
        (data.createdAt is timestamp || isNumberVal(data.createdAt)) &&
        (data.updatedAt is timestamp || isNumberVal(data.updatedAt));
    }

    match /userSeenQuestions/{recordId} {
      allow get: if isSignedIn() && isValidSeenRecordId(recordId) && (
        isAdmin() ||
        recordId.matches('^' + request.auth.uid + '__.*') ||
        (resource != null && resource.data.userId == request.auth.uid)
      );

      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidSeenRecordId(recordId) &&
        isValidUserSeenQuestion(incoming()) &&
        incoming().id == recordId &&
        incoming().userId == request.auth.uid &&
        recordId == request.auth.uid + '__' + incoming().questionId &&
        incoming().seenCount == 1;

      allow update: if isSignedIn() &&
        isValidSeenRecordId(recordId) &&
        isValidUserSeenQuestion(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().questionId == existing().questionId &&
        incoming().firstSeenAtMs == existing().firstSeenAtMs &&
        incoming().createdAt == existing().createdAt &&
        incoming().seenCount >= existing().seenCount &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'lastSeenAtMs',
          'seenCount',
          'mode',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidSeenRecordId(recordId);
    }
  }
}
