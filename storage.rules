rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'emadkhalid277@gmail.com';
    }

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function isValidAudioUpload() {
      return request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/(mpeg|mp3|wav|x-wav|wave|ogg|mp4|x-m4a|aac|webm)');
    }

    // Question images: publicly readable during gameplay, admin-only upload/replace/delete
    match /question-images/{subcategoryId}/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidImageUpload();
      allow delete: if isVerifiedAdmin();
    }

    // Question audio clips: publicly readable during gameplay, admin-only upload/replace/delete
    match /question-audio/{subcategoryId}/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidAudioUpload();
      allow delete: if isVerifiedAdmin();
    }

    // Category images: publicly readable, admin-only upload/replace/delete
    match /category-images/{categoryType}/{categoryId}/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidImageUpload();
      allow delete: if isVerifiedAdmin();
    }

    // User question images: publicly readable, owned user upload
    match /user-question-images/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isVerifiedAdmin());
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
